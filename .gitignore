target/

# JS toolchain
node_modules/
packages/*/node_modules/

# Lockfiles from other package managers (we use pnpm)
package-lock.json
yarn.lock

# Logs / caches
*.log
.pnpm-debug.log*
.DS_Store

# Docs site build output
docs/.vitepress/dist/
docs/.vitepress/cache/

# Void deploy state (the docs site); the project link may be committed
docs/.void/*
!docs/.void/project.json
